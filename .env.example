# Copy to .env and replace every value with a unique, randomly generated secret.
# Never commit .env. This file is a template only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=usims
DB_USER=sims_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APPLICATION_PASSWORD

# Dedicated database account for administrative metadata and backup operations.
# Avoid using the MySQL/MariaDB root account for the application.
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_USER=sims_admin
DB_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ADMIN_PASSWORD
 
# Application sign-in. Generate AUTH_PASSWORD_HASH with:
# node scripts/hash-password.js (enter the password at the hidden prompt)
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH_FROM_HASH_SCRIPT
# Generate a unique random value: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
# Optional comma-separated exact frontend origins. Leave empty for same-origin deployments.
CORS_ORIGIN=
